# Gemini API Key for AI astrophysics report generation (Optional)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
AI_NAME=SPHEREx Analyzer

# Required if the API is reachable from outside this computer (minimum 32 chars).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Enter it in the frontend's access-token field.
ANALYZER_ACCESS_TOKEN=

# Comma-separated exact browser origins allowed to call this backend.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Optional persistent volume for archive response cache in deployments.
# Local default: config/cutouts/live_cache
# SPHEREX_CACHE_DIR=/var/lib/spherex/cache
